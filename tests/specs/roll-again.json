[
  {
    "name": "Roll again sends a fresh result for the message owner",
    "steps": [
      {
        "send": { "text": "/roll" },
        "expect": [{ "method": "sendMessage" }]
      },
      {
        "expect": [
          {
            "method": "answerCallbackQuery"
          },
          {
            "method": "sendMessage",
            "payload": {
              "reply_markup": {
                "inline_keyboard": [[{ "text": "Roll again", "callback_data": "roll:again" }]]
              }
            }
          }
        ],
        "send": {
          "callback": "roll:again",
          "messageId": 1001
        }
      }
    ]
  }
]
